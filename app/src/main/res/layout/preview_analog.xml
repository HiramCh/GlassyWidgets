<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/glass_preview_bg"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="12dp">
    <AnalogClock android:layout_width="100dp" android:layout_height="100dp" android:dial="@drawable/dial_glass" android:hand_hour="@drawable/hand_hour" android:hand_minute="@drawable/hand_minute" />
    <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:format12Hour="EEEE d" android:format24Hour="EEEE d" android:textColor="#FFFFFFFF" android:textSize="20sp" android:fontFamily="sans-serif-light" />
</LinearLayout>
