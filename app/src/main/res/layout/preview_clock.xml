<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/glass_preview_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">
    <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-thin" android:textColor="#FFFFFFFF" android:textSize="44sp" android:includeFontPadding="false" />
    <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="EEEE d MMMM" android:format24Hour="EEEE d MMMM" android:textColor="#CCFFFFFF" android:textSize="14sp" />
</LinearLayout>
